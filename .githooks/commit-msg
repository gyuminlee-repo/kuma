#!/usr/bin/env bash
# Refuse a commit whose message carries no Signed-off-by trailer naming its
# author.
#
# The DCO workflow (.github/workflows/dco.yml) checks every commit a pull
# request adds, but only after the push, so an unsigned commit cost a full CI
# round trip and a history rewrite to fix. This hook applies the same rule
# before the commit exists: the trailer has to be a real trailer as
# `git interpret-trailers --parse` reads it, the name has to match the author
# exactly and the address has to match ignoring case.
#
# The hook never adds the trailer itself. A sign-off certifies the Developer
# Certificate of Origin, and that is the author's statement to make, not the
# tooling's.
#
# A merge that adds no content of its own is exempt, as it is in CI. CI tests
# that with an empty `git show --cc`; before the commit exists the closest
# check is that every staged path matches at least one parent. That is never
# looser than CI, so a merge this hook lets through CI lets through too.
#
# Skip in emergencies: git commit --no-verify
set -e

msg_file="$1"

# Author as git will record it. git exports GIT_AUTHOR_NAME and
# GIT_AUTHOR_EMAIL to commit hooks, so --author and --amend are honoured.
ident=$(git var GIT_AUTHOR_IDENT)
author_name=${ident%% <*}
author_email=${ident#*<}
author_email=${author_email%%>*}

merge_head_file=$(git rev-parse --git-path MERGE_HEAD)
if [ -f "$merge_head_file" ]; then
  own_content=0
  staged_vs_head=$(git diff --cached --name-only HEAD --)
  while read -r parent; do
    [ -n "$parent" ] || continue
    staged_vs_parent=$(git diff --cached --name-only "$parent" --)
    common=$(comm -12 <(printf '%s\n' "$staged_vs_head" | sort) \
                      <(printf '%s\n' "$staged_vs_parent" | sort) | grep -c . || true)
    [ "$common" -gt 0 ] && own_content=1
  done < "$merge_head_file"
  if [ "$own_content" = 0 ]; then
    exit 0
  fi
fi

# The message file still holds comment lines and, with --verbose, the diff
# below the scissors line. Strip both before parsing, as git itself will.
trailers=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$msg_file" \
  | git stripspace --strip-comments \
  | git interpret-trailers --parse \
  | grep -i '^Signed-off-by:' || true)

while IFS= read -r line; do
  [ -n "$line" ] || continue
  value=${line#*:}
  value=${value# }
  signer_name=${value%% <*}
  signer_email=${value##*<}
  signer_email=${signer_email%>}
  if [ "$signer_name" = "$author_name" ] \
    && [ "${signer_email,,}" = "${author_email,,}" ]; then
    exit 0
  fi
done < <(printf '%s\n' "$trailers")

{
  echo "[commit-msg] FAIL: no Signed-off-by trailer matching the author."
  echo "[commit-msg]   author: $author_name <$author_email>"
  if [ -n "$trailers" ]; then
    printf '[commit-msg]   found:  %s\n' "$trailers"
  else
    echo "[commit-msg]   found:  no Signed-off-by trailer"
  fi
  echo "[commit-msg] Every commit needs the DCO sign-off (see the DCO file)."
  echo "[commit-msg] Commit with:            git commit -s"
  echo "[commit-msg] Fix the last commit:    git commit --amend -s --no-edit"
  echo "[commit-msg] Fix a whole branch:     git rebase --signoff <base>"
  echo "[commit-msg] The trailer has to name the author, so set user.name and"
  echo "[commit-msg] user.email to the identity that authors the commit."
} >&2
exit 1
